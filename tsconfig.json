{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "noImplicitAny": false,
      "strictNullChecks": false, // 👈 this suppresses undefined warnings
      "outDir": "dist",
      "moduleResolution": "node",
      "resolveJsonModule": true
    },
    "include": ["src/**/*", "browserContextFixture.ts"]
  }